{
  "name": "football-tournament",
  "version": "2.0.0",
  "private": true,
  "description": "Статический сайт футбольного турнира: таблица, команды, матчи и админ-панель (без бэкенда, данные в localStorage)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "test": "node --test tests/logic.test.js tests/photo.test.js tests/sync.test.js tests/dom.test.js",
    "test:browser": "node --test --test-timeout=90000 tests/browser.test.js",
    "test:all": "npm test && npm run test:browser",
    "serve": "node tools/serve.js"
  },
  "devDependencies": {
    "jsdom": "^30.0.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.17"
  }
}
