/*
  Заголовки ответов для бесплатных хостингов Netlify и Cloudflare Pages
  (GitHub Pages этот файл игнорирует — там работает только CSP из index.html).

  Формат: путь, затем строки "Заголовок: значение".
*/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/* Фото игроков: имена файлов уникальные, поэтому кэш можно держать вечно */
/assets/photos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=604800

/assets/js/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=3600
